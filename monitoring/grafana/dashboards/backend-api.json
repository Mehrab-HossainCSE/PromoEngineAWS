    {
      "id": 14,
      "type": "timeseries",
      "title": "Working set",
      "description": "Resident memory of the API process. Compare with the container memory limit: Docker kills at the limit, with exit code 137 and nothing in the application log.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
