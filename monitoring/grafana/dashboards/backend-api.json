            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "API up",
      "description": "1 if the last scrape of /metrics succeeded. Synthesised by Prometheus, so it exists even when the application publishes nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
