# =============================================================================
# PromoEngine - environment template
#
# Copy to .env NEXT TO docker-compose.yml on the EC2 host and fill in. The real
# .env is never committed (.gitignore already excludes .env and .env.*), and in
# normal operation you do not write it by hand at all: the GitHub Actions deploy
# job generates it from repository secrets on every push to main.
#
#   cp .env.example .env && chmod 600 .env
#
# Docker Compose reads this file automatically from the directory it runs in.
# =============================================================================

# -- Docker Hub ---------------------------------------------------------------
# Namespace the images were pushed under. From the DOCKER_USERNAME secret.
DOCKER_USERNAME=your-dockerhub-username

# Which image tag this host runs. The pipeline pins it to the deployed commit
# SHA so a rollback is a one-line edit followed by `docker compose up -d`.
IMAGE_TAG=latest

# -- PostgreSQL ---------------------------------------------------------------
# Superuser role. It must be able to run CREATE DATABASE, because that is how a
# tenant database is created at sign up.
POSTGRES_USER=postgres

# From the POSTGRES_PASSWORD secret. Required - Compose refuses to start
# without it rather than falling back to something guessable.
POSTGRES_PASSWORD=

# Control-plane catalog database, from the POSTGRES_DB secret. Tenant databases
# are created alongside it at run time and are not listed here.
POSTGRES_DB=PromoEngineCatalog

# -- Multi-tenancy ------------------------------------------------------------
# Prefix for every tenant database name: jane@contoso.com becomes
# PromoEngine_Tenant_jane_contoso_com. Changing this after tenants exist orphans
# their databases - the catalog keeps the old names, new tenants get new ones.
TENANT_DB_PREFIX=PromoEngine_Tenant_

# Seed a freshly provisioned tenant database with demo campaigns and stores.
TENANT_SEED_SAMPLE_DATA=true

# -- Authentication -----------------------------------------------------------
# HMAC key for JWT signing, 32 bytes minimum. Generate with:
#   openssl rand -base64 48
# The deploy script creates one on the first deploy and then leaves it alone,
# because rotating it signs every user out.
JWT_SIGNING_KEY=
JWT_ISSUER=PromoEngine
JWT_AUDIENCE=PromoEngine.Client

# -- External promotion API ---------------------------------------------------
# Shared key that external callers present to the /api/external endpoints.
# Generated on first deploy if unset; hand the generated value to the callers.
EXTERNAL_API_KEY=

# -- Public surface -----------------------------------------------------------
# Origin browsers reach this deployment on, used for the CORS allow-list.
# Set it to the EC2 public DNS name or your domain, scheme included.
PUBLIC_ORIGIN=http://your-ec2-public-dns

# Host port the frontend binds. 80 for plain HTTP; put a TLS terminator in
# front and move this to 8080 when you add HTTPS.
HTTP_PORT=80

# -- Diagnostics --------------------------------------------------------------
LOG_LEVEL=Information
