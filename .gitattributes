# =============================================================================
# Line-ending policy
#
# This repository is edited on Windows but its deployment artefacts run on
# Linux. A shell script checked out with CRLF fails on the EC2 host with
# "bad interpreter: No such file or directory", and Docker chokes on a CRLF
# entrypoint the same way. Everything below is therefore pinned to LF
# regardless of the developer's core.autocrlf setting.
# =============================================================================

# Let Git decide for anything not named explicitly.
* text=auto

# ---- must be LF: executed on Linux ----
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Grafana Alloy's configuration language is not YAML and has its own extension.
# It is bind-mounted into the Alloy container and parsed there.
*.alloy         text eol=lf

# The alert contact-point template. deploy.sh filters it on the EC2 host and
# writes the result where Grafana reads it, so a CR would travel into the
# generated YAML.
*.example       text eol=lf

# Copied to the EC2 host and parsed there by deploy.sh. The parser strips a
# trailing CR defensively, but the file has no reason to carry one.
.env            text eol=lf

# ---- must be CRLF: Windows tooling ----
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ---- binary: never convert, never diff as text ----
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.pdf           binary
*.xlsx          binary
*.zip           binary
*.dll           binary
*.exe           binary

# ---- generated: collapse in pull-request diffs ----
package-lock.json linguist-generated=true -diff
