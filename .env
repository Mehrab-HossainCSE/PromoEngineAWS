# =============================================================================
# PromoEngine - application configuration
#
# THIS FILE IS COMMITTED TO THE REPOSITORY, ON PURPOSE.
#
# It carries the database configuration and the deployment tunables. The CI/CD
# pipeline copies it to /opt/promoengine/.env on the EC2 host and merges the
# five GitHub secrets on top of it.
#
# Because it is committed, ONLY put values here that you accept being visible
# to anyone who can read the repository. Everything below is read by
# docker-compose.yml through ${VARIABLE} substitution.
#
# Values NOT in this file, and where they come from instead:
#   POSTGRES_DB       <- GitHub secret, injected at deploy time
#   POSTGRES_PASSWORD <- GitHub secret, injected at deploy time
#   DOCKER_USERNAME   <- GitHub secret, injected at deploy time
#   IMAGE_TAG         <- the deployed commit SHA, set by the pipeline
#   PUBLIC_ORIGIN     <- built from the AWS_HOST secret at deploy time
#   JWT_SIGNING_KEY   <- generated once on the EC2 host, never leaves it
#   EXTERNAL_API_KEY  <- generated once on the EC2 host, never leaves it
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# The role that owns the database server. It must be able to run
# CREATE DATABASE, because that is how a tenant database is created at sign up.
# `postgres` is the superuser created by initdb and satisfies that by default.
# Not a secret on its own - the password is what protects the server.
POSTGRES_USER=postgres

# POSTGRES_DB and POSTGRES_PASSWORD are deliberately ABSENT from this file.
#
# They are GitHub repository secrets, injected at deploy time, because this
# file is committed and the repository is readable by others. Set them at
# Settings -> Secrets and variables -> Actions:
#
#   POSTGRES_DB        the control-plane ("master") database that holds
#                      tenants, users, plans and subscriptions, e.g.
#                      PromoEngineCatalog. Per-tenant databases are created
#                      next to it at run time and are never named anywhere.
#
#   POSTGRES_PASSWORD  password for POSTGRES_USER. Keep it ALPHANUMERIC: it is
#                      interpolated into an Npgsql connection string, where `;`
#                      and `=` are delimiters, and into an env file, where `#`
#                      starts a comment. Generate one with
#                        openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
#
# Changing the password after tenants exist needs more than editing the secret
# - see DEPLOYMENT.md section 3.

# -----------------------------------------------------------------------------
# Multi-tenancy
# -----------------------------------------------------------------------------
# Prefix for every tenant database: jane@contoso.com becomes
# PromoEngine_Tenant_jane_contoso_com. Changing it after tenants exist orphans
# their databases - the catalog keeps the old names, new tenants get new ones.
TENANT_DB_PREFIX=PromoEngine_Tenant_

# Seed a freshly provisioned tenant database with demo campaigns and stores.
TENANT_SEED_SAMPLE_DATA=true

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Host port the frontend binds. 80 for plain HTTP; move it to 8080 and put a
# TLS terminator in front when you add HTTPS.
HTTP_PORT=80

LOG_LEVEL=Information

# -----------------------------------------------------------------------------
# Monitoring and observability
#
# The stack in docker-compose.monitoring.yml: Prometheus, Grafana, Loki, Alloy,
# Node Exporter and cAdvisor. Applied as an OVERLAY on top of this file's stack,
# so it can be switched off entirely without touching the application.
#
# Values NOT in this file, and where they come from instead:
#   GRAFANA_ADMIN_PASSWORD    <- generated once on the EC2 host by deploy.sh and
#                                preserved afterwards, exactly like JWT_SIGNING_KEY.
#                                Override it with a GitHub secret of the same name.
#   GRAFANA_ALERT_WEBHOOK_URL <- optional GitHub secret. A Slack/Teams webhook URL
#                                is a credential, so it is never committed.
#   GRAFANA_ROOT_URL          <- built from AWS_HOST at deploy time.
# -----------------------------------------------------------------------------

# Set to false to deploy the application with no monitoring at all. deploy.sh
# then stops and removes the six monitoring containers but LEAVES their volumes,
# so turning it back on restores the history.
MONITORING_ENABLED=true

# Where Grafana's port is published on the EC2 host.
#
# 127.0.0.1 means "loopback only": reachable from the instance itself and over an
# SSH tunnel, and NOT from the internet. That is the right default while this host
# has no TLS, because otherwise every Grafana login crosses the internet in clear
# text.
#
#   ssh -i your-key.pem -L 3000:localhost:3000 ubuntu@<ec2-public-ip>
#   then browse to http://localhost:3000
#
# To expose it directly instead, set this to 0.0.0.0 AND add an inbound rule for
# the port in the EC2 security group - restricted to your own IP, not 0.0.0.0/0.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# Set to true once there is HTTPS in front of Grafana. Leave false until then:
# a Secure cookie is never sent over plain HTTP, and the login silently loops.
GRAFANA_COOKIE_SECURE=false
GRAFANA_LOG_LEVEL=warn

# How long metrics are kept, and a hard size ceiling. Whichever is reached first
# wins, so a burst of new series cannot fill the disk ahead of the time limit.
# Log retention is separate and lives in monitoring/loki/loki-config.yml.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=4GB

# Per-container memory ceilings. Together with the application these come to
# roughly 1.5 GB, so t3.small (2 GB) is the practical minimum and t3.medium is
# comfortable. Docker kills a container that crosses its own limit, which is a
# far better outcome than the kernel OOM killer choosing PostgreSQL.
PROMETHEUS_MEM_LIMIT=512m
GRAFANA_MEM_LIMIT=384m
LOKI_MEM_LIMIT=384m
ALLOY_MEM_LIMIT=256m
NODE_EXPORTER_MEM_LIMIT=128m
CADVISOR_MEM_LIMIT=256m

# Stamped onto every log line as labels, so a second instance or a staging box
# stays distinguishable in the same Grafana.
MONITORING_ENVIRONMENT=production
MONITORING_HOSTNAME=ec2
