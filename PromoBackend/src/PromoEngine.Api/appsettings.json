{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Catalog": "Host=localhost;Port=5432;Database=PromoEngineCatalog;Username=postgres;Password=postgres"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "Jwt": {
    "Issuer": "PromoEngine",
    "Audience": "PromoEngine.Client",
    "SigningKey": "replace-this-with-a-32-byte-or-longer-secret-in-every-real-environment",
    "AccessTokenMinutes": 480,
    "GuestTokenMinutes": 120
  },

  "Pricing": {
    "PriceEventProcessingDays": 2,
    "MultipleUnitsOfMeasure": true
  },

  "ItemUpload": {
    "MaxFileBytes": 5242880,
    "MaxRows": 5000
  },

  "ExternalPromotionApi": {
    "ApiKey": "EX-API-KEY-ICURES-APEX",
    "TenantSlug": ""
  },

  "Tenancy": {
    "Provisioner": "Local",
    "DatabaseNamePrefix": "PromoEngine_Tenant_",
    "SeedSampleData": true,

    "Local": {
      "ServerConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres"
    },

    "Aws": {
      "Mode": "DatabaseOnSharedInstance",
      "Region": "us-east-1",
      "SharedInstanceIdentifier": "",
      "SharedInstanceEndpoint": "",
      "MasterUsername": "promoadmin",
      "MasterPassword": "",
      "Port": 5432,
      "InstanceClass": "db.t3.small",
      "Engine": "postgres",
      "EngineVersion": "16.4",
      "AllocatedStorageGb": 20,
      "DbSubnetGroupName": "",
      "VpcSecurityGroupIds": [],
      "PubliclyAccessible": false,
      "WaitTimeoutMinutes": 30
    }
  }
}
